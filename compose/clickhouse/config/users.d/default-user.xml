<clickhouse>
  <!-- Docs: <https://clickhouse.com/docs/operations/settings/settings_users/> -->
  <users>
    <!-- Remove default user -->
    <default remove="remove">
    </default>

    <core>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_PASSWORD" />
      <quota>default</quota>
      <access_management>1</access_management>
      <named_collection_control>1</named_collection_control>
      <!-- access_management/named_collection_control сами по себе не дают core ни одной
           привилегии — они лишь разрешают пользоваться SQL-управлением доступом/named
           collections, если нужные права уже есть. А их неоткуда взять: core — единственная
           учётка в кластере (default удалён выше), самому себе GRANT ... WITH GRANT OPTION
           на то, чего не имеешь, ClickHouse не даёт (проверено: ACCESS_DENIED и на CREATE
           NAMED COLLECTION, и на попытку выдать этот грант себе). Поэтому бутстрапим
           стартовым грантом прямо в конфиге — единственный путь без отдельного admin-аккаунта. -->
      <grants>
        <query>GRANT NAMED COLLECTION ADMIN ON * WITH GRANT OPTION</query>
        <query>GRANT NAMED COLLECTION ON * WITH GRANT OPTION</query>
      </grants>
    </core>
  </users>
</clickhouse>
