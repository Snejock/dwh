<clickhouse>
  <!-- Docs: <https://clickhouse.com/docs/operations/settings/settings_users/> -->
  <!-- users.xml не определяет пользователя default, поэтому убирать его здесь через
       remove="remove" не нужно (и нельзя — merge упадёт с "Not found: users.default",
       если в базовом конфиге нечего удалять). -->
  <users>
    <core>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_PASSWORD" />
      <quota>default</quota>
      <access_management>1</access_management>
      <named_collection_control>1</named_collection_control>
    </core>
  </users>
</clickhouse>
